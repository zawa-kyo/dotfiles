#!/usr/bin/env bash
#MISE hide=true
#MISE description="Format JSON, Markdown, and YAML files with Prettier"

set -eu

tmpfile="$(mktemp)"
trap 'rm -f "$tmpfile"' EXIT

git ls-files -z -- \
	'*.json' '*.jsonc' '*.md' '*.yaml' '*.yml' \
	':(exclude)**/lazy-lock.json' \
	':(exclude)dotfiles/ai/apm/apm.lock.yaml' \
	':(exclude)**/*.lock' |
	while IFS= read -r -d '' file; do
		if [ -f "$file" ]; then
			printf '%s\0' "$file"
		fi
	done >"$tmpfile"
if [ -s "$tmpfile" ]; then
	xargs -0 prettier --write <"$tmpfile"
fi

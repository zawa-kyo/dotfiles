#!/usr/bin/env bash
#MISE hide=true
#MISE description="Format Go files with gofmt"

set -eu

tmpfile="$(mktemp)"
trap 'rm -f "$tmpfile"' EXIT

git ls-files -z -- '*.go' |
	while IFS= read -r -d '' file; do
		if [ -f "$file" ]; then
			printf '%s\0' "$file"
		fi
	done >"$tmpfile"
if [ -s "$tmpfile" ]; then
	xargs -0 gofmt -w <"$tmpfile"
fi
